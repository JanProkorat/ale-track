# Copy to `.env` (git-ignored) and fill in real values.

# Backend REST API base URL (no trailing slash). The client appends the
# `ale-track/` route prefix itself.
VITE_API_BASE_URL=http://localhost:8080

# Company depot address + coordinates (JSON), used as the start/end of delivery routes.
VITE_COMPANY_ADDRESS={"label":"Sklad AleTrack","city":"Žitava","lat":50.897,"lng":14.807}
